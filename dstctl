source "${DSTCTL_ROOT}/lib/cluster.sh"
# shellcheck disable=SC1091
source "${DSTCTL_ROOT}/lib/mods.sh"
# shellcheck disable=SC1091
source "${DSTCTL_ROOT}/lib/process.sh"
# shellcheck disable=SC1091
source "${DSTCTL_ROOT}/lib/console.sh"
# shellcheck disable=SC1091
source "${DSTCTL_ROOT}/lib/players.sh"
# shellcheck disable=SC1091
source "${DSTCTL_ROOT}/lib/status.sh"
# shellcheck disable=SC1091
source "${DSTCTL_ROOT}/lib/backup.sh"
# shellcheck disable=SC1091
source "${DSTCTL_ROOT}/lib/watchdog.sh"
# shellcheck disable=SC1091
source "${DSTCTL_ROOT}/lib/cli.sh"
# shellcheck disable=SC1091
source "${DSTCTL_ROOT}/lib/menu.sh"

dstctl_main "$@"
